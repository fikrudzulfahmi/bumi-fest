includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/

    ignoreErrors:
        # Breeze vendor code (not ours)
        - '#Parameter.*Verified constructor#'
        # Larastan belum mengenali enum cast pada model property secara akurat
        # (role di-cast ke App\Enums\Role via casts(), tapi PHPDoc tetap string).
        - '#Strict comparison using === between string and App\\Enums\\Role#'
        - '#Match arm comparison between string and App\\Enums\\Role#'
        # Generic missing types (trade-off dengan Laravel Eloquent patterns)
        - '#return type with generic class Illuminate\\Database\\Eloquent\\Relations#'
