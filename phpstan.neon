includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - app/

    ignoreErrors:
        # Breeze vendor code (not ours)
        - '#Parameter.*Verified constructor#'
        # Generic missing types (trade-off dengan Laravel Eloquent patterns)
        - '#return type with generic class Illuminate\\Database\\Eloquent\\Relations#'
